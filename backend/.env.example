# Local (non-Docker) use only -- e.g. running `prisma migrate dev` or the
# dev server directly on the host. Copy to backend/.env (gitignored).
#
# DATABASE_URL isn't set by docker-compose.yml itself: inside containers the
# backend builds its Postgres connection from DATABASE_HOST/PORT/NAME/USER +
# the DB_PASSWORD_FILE secret (see src/env.ts). Outside Docker, build it by
# hand from docker/secrets/db_password.txt (URL-encode it -- it's base64 and
# may contain '+', '/', '=').
DATABASE_URL="postgresql://vigan:CHANGEME@localhost:5433/vigan_ucrms?schema=public"

PORT=4000
DB_PASSWORD=CHANGEME
SESSION_SECRET=CHANGEME
ENCRYPTION_KEY=CHANGEME

# Idle timeout for server-side sessions, in minutes (spec default: ~30).
SESSION_IDLE_TIMEOUT_MINUTES=30

# Phase 3 RBAC role passwords -- from docker/secrets/*_db_password.txt,
# provisioned via `npm run db:provision-roles`. Needed for src/db/rbac.test.ts
# (connects directly as each role) and DATABASE_HOST/PORT/NAME below (which
# databaseUrlForRole() also needs, separately from DATABASE_URL above).
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=vigan_ucrms
CSWD_STAFF_DB_PASSWORD=CHANGEME
AGRI_STAFF_DB_PASSWORD=CHANGEME
CIVIL_REGISTRY_STAFF_DB_PASSWORD=CHANGEME
ADMIN_DB_PASSWORD=CHANGEME
APP_SERVICE_DB_PASSWORD=CHANGEME

# Frontend origin allowed to make credentialed CORS requests (Vite dev server default).
CORS_ORIGIN=http://localhost:5173

# Phase 6: MinIO, for Civil Registry's birth-certificate uploads. Needs
# `docker compose up -d minio` running locally. Secret key reuses DB_PASSWORD
# above (see docker-compose.yml's MINIO_ROOT_PASSWORD_FILE).
# Uploaded documents: 'minio' (Docker stack) or 'local' (folder on this
# server, e.g. when the MinIO image isn't available). DOCUMENT_DIR is used
# only for 'local'.
DOCUMENT_STORAGE=minio
DOCUMENT_DIR=storage/documents
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=vigan_admin
