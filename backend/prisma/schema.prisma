// PK strategy: spec calls for UUIDv7 (time-ordered) "if your Prisma/Postgres
// version supports it, else UUIDv4". Postgres 15 has no built-in uuidv7()
// (that lands in PG18) and we're avoiding a hand-rolled plpgsql uuidv7
// implementation in a compliance-sensitive schema. Using gen_random_uuid()
// (UUIDv4, built into Postgres core since v13, no extension needed) per the
// spec's own fallback clause. Revisit when the target Postgres version ships
// native uuidv7().
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm]
}

// --- Reference data -------------------------------------------------------

model Barangay {
  code String @id @db.VarChar(10) // PSGC code
  name String @unique

  citizens Citizen[]

  @@map("barangay")
}

// --- Master identity table -------------------------------------------------

model Citizen {
  personKey           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("person_key")
  personParentKey     String?   @db.Uuid @map("person_parent_key")
  personSubParentKey  String?   @db.Uuid @map("person_sub_parent_key")
  personIsHead        Boolean   @default(false) @map("person_is_head")
  personRelationToHead String?  @map("person_relation_to_head")

  personLname String  @map("person_lname")
  personFname String  @map("person_fname")
  personMname String? @map("person_mname")

  personStreet   String? @map("person_street")
  personBrgyCode String? @db.VarChar(10) @map("person_brgy_code")

  personSex         String?   @map("person_sex")
  personGender      String?   @map("person_gender")
  personBdate       DateTime? @db.Date @map("person_bdate")
  personCivilStatus String?   @map("person_civil_status")
  personReligion    String?   @map("person_religion")

  personEducLevel  String? @map("person_educ_level")
  personEducCourse String? @map("person_educ_course")

  personOccupation           String? @map("person_occupation")
  personOccupationIndustry   String? @map("person_occupation_industry")
  personOccupationBusName    String? @map("person_occupation_bus_name")
  personOccupationBusAddress String? @map("person_occupation_bus_address")

  // Encrypted at rest (pgcrypto pgp_sym_encrypt) -- ciphertext bytes, never
  // plaintext. Encrypt/decrypt happens in the app service layer (Phase 8),
  // not here. Left null by the Phase 1 seed script.
  personSssEnc        Bytes? @map("person_sss_enc")
  personGsisEnc        Bytes? @map("person_gsis_enc")
  personPhilhealthEnc Bytes? @map("person_philhealth_enc")

  createdAt DateTime @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz() @map("updated_at")
  createdBy String?  @db.Uuid @map("created_by")
  updatedBy String?  @db.Uuid @map("updated_by")

  isArchived Boolean @default(false) @map("is_archived")

  barangay    Barangay? @relation(fields: [personBrgyCode], references: [code])
  parent      Citizen?  @relation("HouseholdParent", fields: [personParentKey], references: [personKey])
  children    Citizen[] @relation("HouseholdParent")
  subParent   Citizen?  @relation("HouseholdSubParent", fields: [personSubParentKey], references: [personKey])
  subChildren Citizen[] @relation("HouseholdSubParent")

  officeRecords OfficeRecord[]
  outreach      OutreachContact[]

  // Drives resolvePerson()'s exact-match step (Phase 2).
  @@index([personLname, personFname, personBdate])
  // Household members, and barangay filters (20261012100000_speed_indexes).
  @@index([personParentKey])
  @@index([personBrgyCode])
  @@map("Citizen")
}

// --- Offices, modules, form fields, records ---------------------------------
// Every office (the original CSWD/Agriculture/Civil Registry included, as of
// the migration that removed their dedicated tables/Postgres roles -- see
// 20260827150000_unify_offices_into_modules) is a row here, sharing the one
// `office_staff` Postgres role. Isolation between offices is enforced at the
// application layer (office_id/requireOfficeAccess), not by a dedicated DB
// role per office -- tried once for a single extra office
// (business_permits_staff, see 20260827110000_remove_business_permits_office)
// and reverted, so it was never going to scale to every office having its
// own role.
model Office {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz() @map("updated_at")
  createdBy   String?  @db.Uuid @map("created_by")
  // Admin-set acronym (CENRO, BPLO...); null = derived from name in the UI.
  shortName   String?  @map("short_name")
  accentHue   Int      @default(255) @map("accent_hue")
  icon        String   @default("building")

  modules       OfficeModule[]
  staffAccounts StaffAccount[]

  @@map("office")
}

enum OfficeFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  FILE
  MULTISELECT
  TEXTAREA
  EMAIL
  PHONE
  TIME
}

// One form/record-type within an office. Most offices have exactly one
// module; some need more than one under a single login -- CSWD has three
// (Senior Citizen, PWD, Solo Parent), Civil Registry has two (Birth,
// Death). slug is the module's identifier within its office (unique per
// office, not globally).
model OfficeModule {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officeId String @db.Uuid @map("office_id")
  name     String
  slug     String

  // Whether a submission must resolve to a Citizen (the common case) or may
  // stand alone with no link at all -- Civil Registry's Birth module sets
  // this false: a family that doesn't live in Vigan still gets the birth
  // recorded, just with nothing to link to. See office.ts's intake route
  // for how this gates resolvePerson().
  requiresCitizenLink Boolean @default(true) @map("requires_citizen_link")
  sortOrder           Int     @default(0) @map("sort_order")

  // Last/first/middle name + birthdate are never optional -- resolvePerson()
  // needs all four on every submission, for every module, to match/dedupe
  // against the shared Citizen registry (see PersonCoreFields.tsx). These
  // four toggle whether the rest of that same core block is collected too;
  // default true so every existing module keeps collecting exactly what it
  // already did.
  collectSex          Boolean @default(true) @map("collect_sex")
  collectCivilStatus  Boolean @default(true) @map("collect_civil_status")
  collectStreet       Boolean @default(true) @map("collect_street")
  collectBarangay     Boolean @default(true) @map("collect_barangay")

  // Whether this module collects a person's identity at all. Off is for a
  // module that isn't about a person in the first place -- an Assessor's
  // "Lots" module records land, not people -- so its records carry no
  // person_key and no unresolved_person, just admin-defined fields. Always
  // forces requiresCitizenLink false: resolvePerson() has nothing to match
  // on without a name, so a module can't require a Citizen link while
  // declining to collect one. The four collect* flags above only mean
  // anything when this is true.
  collectPersonInfo   Boolean @default(true) @map("collect_person_info")

  createdAt DateTime @default(now()) @db.Timestamptz() @map("created_at")

  office           Office            @relation(fields: [officeId], references: [id])
  formFields       OfficeFormField[]
  records          OfficeRecord[]
  dashboardWidgetSources DashboardWidgetSource[]
  gapRules         ProgramGapRule[]

  @@unique([officeId, slug])
  @@map("office_module")
}

// One row per admin-defined field on a module's intake form (on top of the
// same core name/birthdate/address fields every module's form collects) --
// `key` is the JSON key the answer is stored under in OfficeRecord.data,
// `options` only used when fieldType is SELECT, FILE stores the MinIO
// object key of an uploaded document as its value.
model OfficeFormField {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId   String          @db.Uuid @map("module_id")
  key        String
  label      String
  fieldType  OfficeFieldType @map("field_type")
  options    String[]
  isRequired Boolean         @default(false) @map("is_required")
  sortOrder  Int             @default(0) @map("sort_order")
  createdAt  DateTime        @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt  DateTime        @updatedAt @db.Timestamptz() @map("updated_at")

  module OfficeModule @relation(fields: [moduleId], references: [id])

  @@unique([moduleId, key])
  @@map("office_form_field")
}

// The one satellite-record shape every module uses -- soft-delete + audit
// columns, admin-defined fields as one JSONB blob instead of named columns
// (the field set isn't known at migration time). personKey is nullable for
// modules with requiresCitizenLink = false; when null, unresolvedPerson
// carries the submitted {lname, fname, mname, bdate} that would otherwise
// have lived on the Citizen row, so the record's identity is never only
// inside a queue item waiting on a decision that may never come.
model OfficeRecord {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("record_key")
  moduleId         String  @db.Uuid @map("module_id")
  personKey        String? @db.Uuid @map("person_key")
  unresolvedPerson Json?   @map("unresolved_person")
  data             Json

  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt  DateTime @updatedAt @db.Timestamptz() @map("updated_at")
  createdBy  String?  @db.Uuid @map("created_by")
  updatedBy  String?  @db.Uuid @map("updated_by")

  module  OfficeModule @relation(fields: [moduleId], references: [id])
  citizen Citizen?     @relation(fields: [personKey], references: [personKey])

  // Two more, partial (WHERE NOT is_archived), exist only in SQL since Prisma
  // can't express them: (person_key, module_id) and (module_id, created_at
  // DESC). See 20261012100000_speed_indexes.
  @@index([moduleId])
  @@index([personKey])
  @@map("office_record")
}

// An admin-saved chart on the dashboard, built from a fixed "recipe"
// (source modules + 0-2 group-by dimensions + chart type) rather than
// arbitrary SQL/joins -- same reasoning as the form fields' fixed type
// palette. groupBy is empty (ungrouped total, chartType 'number'), or 1-2
// of 'barangay', 'sex', 'month' (intake month), 'age_bracket' (10-year
// bands off person_bdate), or 'field:<key>' naming a source module's own
// form field -- with 2, the chart's label is the composite "dim1 / dim2"
// (e.g. "Poblacion / M"). See services/dashboardWidgets.ts for how this
// recipe is turned into a query.
//
// One or more source modules -- consolidating data across offices (e.g.
// "seniors vs. PWDs vs. farmers, by barangay") is the whole point of a
// widget spanning modules rather than being one office's private chart.
// Each source becomes its own series on the resulting chart, sharing one
// group-by axis.
model DashboardWidget {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  groupBy   String[] @map("group_by")
  chartType String   @map("chart_type")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @db.Timestamptz() @map("created_at")
  createdBy String?  @db.Uuid @map("created_by")
  // Saved visualizations only appear on the admin Dashboard when true.
  showOnDashboard Boolean @default(true) @map("show_on_dashboard")
  // 'count' (records) or 'sum:<fieldKey>' (total of a NUMBER field).
  measure String @default("count")
  // Owning office for charts made by that office's staff; null = city-wide (admin).
  officeId String? @db.Uuid @map("office_id")

  // Optional value filters that narrow the widget's query without being a
  // chart axis themselves (e.g. "Farmers in just Barangay X") -- distinct
  // from groupBy, which always breaks out every value of a dimension.
  filterBarangayCode String? @db.VarChar(10) @map("filter_barangay_code")
  filterSex          String? @map("filter_sex")
  filterMonth        String? @map("filter_month") // 'YYYY-MM'
  // "Only records where data[filterFieldKey] = filterFieldValue".
  filterFieldKey     String? @map("filter_field_key")
  filterFieldValue   String? @map("filter_field_value")

  sources DashboardWidgetSource[]

  @@map("dashboard_widget")
}

// Join row: one per (widget, source module) pair -- see DashboardWidget's
// comment above for why a widget can chart more than one module at once.
model DashboardWidgetSource {
  widgetId String @db.Uuid @map("widget_id")
  moduleId String @db.Uuid @map("module_id")

  widget DashboardWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  module OfficeModule    @relation(fields: [moduleId], references: [id])

  @@id([widgetId, moduleId])
  @@map("dashboard_widget_source")
}

// --- Staff accounts (auth) ----------------------------------------------------
// `role` doubles as the name of the matching Postgres login role. Only two
// roles exist as of the offices-as-modules migration: `admin`, and
// `office_staff` which covers every office (the original CSWD/Agriculture/
// Civil Registry included), scoped by `officeId` below -- an office_staff
// session sees every module under that office as a tab. The three
// former per-office roles (cswd_staff, agri_staff, civil_registry_staff)
// were migrated to office_staff and removed from this enum entirely --
// see 20260827150000_unify_offices_into_modules for the same
// create-new-type/swap technique already used once before to drop
// business_permits_staff.

enum StaffRole {
  admin
  office_staff
}

// connect-pg-simple's session-store table (raw-SQL, Phase 3 migration) --
// declared here purely so `prisma migrate dev`'s diff doesn't see it as
// drift and propose dropping it on every future migration. @@ignore keeps
// it out of the generated Prisma Client; nothing in app code should ever
// query it through Prisma -- connect-pg-simple owns it via its own pg Pool.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
  @@ignore
}

model StaffAccount {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  // Job title, e.g. "Social Welfare Aide" (free text, optional).
  position     String?
  role         StaffRole
  // Only set (and required) when role = office_staff -- which office this
  // account signs in as; it sees every module under that office.
  officeId     String?   @db.Uuid @map("office_id")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt    DateTime  @updatedAt @db.Timestamptz() @map("updated_at")

  office Office? @relation(fields: [officeId], references: [id])

  @@map("staff_account")
}

// --- Runtime config ----------------------------------------------------------
// Admin-adjustable settings (e.g. fuzzy-match threshold) that must be
// changeable without a code deploy. Missing keys fall back to defaults in
// src/services/config.ts.

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @db.Timestamptz() @map("updated_at")
  updatedBy String?  @db.Uuid @map("updated_by")

  @@map("app_setting")
}

// --- Duplicate review queue ----------------------------------------------------
// resolvePerson() returning 'needs_review' means the intake can't be
// auto-decided -- the module's write-path stops here and queues the intake
// instead of creating a record.

enum DuplicateReviewStatus {
  pending
  approved
  rejected
}

model DuplicateReviewQueueItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Which module the intake was headed for, and the full original
  // submission ({lname, fname, mname, bdate, fields}), replayed once a
  // reviewer decides.
  moduleId      String @db.Uuid @map("module_id")
  candidateData Json   @map("candidate_data")
  fuzzyMatches  Json   @map("fuzzy_matches")

  status DuplicateReviewStatus @default(pending)

  createdBy String   @db.Uuid @map("created_by")
  createdAt DateTime @default(now()) @db.Timestamptz() @map("created_at")

  reviewedBy String?   @db.Uuid @map("reviewed_by")
  reviewedAt DateTime? @db.Timestamptz() @map("reviewed_at")
  // The person_key the queued intake ended up linked to once resolved
  // (winning key on approve, new Citizen on reject).
  resolvedPersonKey String? @db.Uuid @map("resolved_person_key")

  @@index([status])
  @@map("duplicate_review_queue_item")
}

// --- Audit log ---------------------------------------------------------------
// Append-only / admin-read-only enforcement (trigger or REVOKE blocking
// UPDATE/DELETE for every role) is Phase 3 scope (RBAC/RLS), not this phase.

enum AuditAction {
  insert
  update
  delete
  read
  merge
}

model AuditLog {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableName     String      @map("table_name")
  recordId      String?     @db.Uuid @map("record_id")
  action        AuditAction
  actorUserId   String?     @db.Uuid @map("actor_user_id")
  actorRole     String?     @map("actor_role")
  changedFields Json?       @map("changed_fields")
  timestamp     DateTime    @default(now()) @db.Timestamptz()

  @@index([tableName, recordId])
  @@index([actorUserId])
  @@map("audit_log")
}

// --- Program gaps ---------------------------------------------------------------
// One rule = one question asked of the shared registry, e.g. "citizens aged
// 60+ who are NOT on the Senior Citizen list" (kind 'missing') or "people
// with a death record who ARE still on the PWD list" (kind 'conflict').
// Conditions are a fixed recipe (age range, sex, being in any of some source
// programs), not free SQL, so an admin can edit rules safely from the web
// app. Computed live by services/programGaps.ts; nothing is stored per person.
model ProgramGapRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  description     String?
  kind            String   @default("missing") // 'missing' | 'conflict'
  targetModuleId  String   @map("target_module_id") @db.Uuid
  sourceModuleIds String[] @map("source_module_ids") @db.Uuid
  minAge          Int?     @map("min_age")
  maxAge          Int?     @map("max_age")
  sex             String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  targetModule OfficeModule @relation(fields: [targetModuleId], references: [id])
  outreach     OutreachContact[]

  @@map("program_gap_rule")
}

// Outreach on a "not yet served" rule: whether a person on the list has been
// contacted and what came of it ('reached' = will come in, 'declined',
// 'not_found', 'moved'). One row per rule and person; history is in the
// audit log. Read and written with raw SQL in services/programGaps.ts.
model OutreachContact {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId      String   @map("rule_id") @db.Uuid
  personKey   String   @map("person_key") @db.Uuid
  status      String
  note        String?
  contactedOn DateTime @default(dbgenerated("CURRENT_DATE")) @map("contacted_on") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz()
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  rule    ProgramGapRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  citizen Citizen        @relation(fields: [personKey], references: [personKey], onDelete: Cascade)

  @@unique([ruleId, personKey])
  @@index([personKey])
  @@map("outreach_contact")
}

// --- Data subject requests (RA 10173) -------------------------------------------
// A citizen asking to see, correct or delete their data, or objecting to its
// use. Logged so the city can show each request was answered. personKey is
// optional: the requester may not be in the registry. Never hard-deleted.
model DataRequest {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personKey     String?   @db.Uuid @map("person_key")
  requesterName String    @map("requester_name")
  contact       String?
  kind          String // 'access' | 'correction' | 'erasure' | 'objection' | 'other'
  details       String?
  receivedOn    DateTime  @db.Date @map("received_on")
  status        String    @default("open") // 'open' | 'done' | 'declined'
  response      String?
  closedOn      DateTime? @db.Date @map("closed_on")
  createdAt     DateTime  @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt     DateTime  @updatedAt @db.Timestamptz() @map("updated_at")
  createdBy     String?   @db.Uuid @map("created_by")
  updatedBy     String?   @db.Uuid @map("updated_by")

  @@index([personKey])
  @@map("data_request")
}

