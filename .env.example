# Non-secret config only. Real secrets (DB password, session secret,
# encryption key) live as Docker secret files under docker/secrets/*.txt
# (gitignored) -- see docker/secrets/README.md. Never put secrets here.

NODE_ENV=development

POSTGRES_USER=vigan
POSTGRES_DB=vigan_ucrms
# 5432 collides with a locally-installed Postgres on some machines --
# if `docker compose up` reports auth failures, check nothing else already
# owns this port (netstat/Get-NetTCPConnection) and remap it here.
POSTGRES_PORT=5432

MINIO_ROOT_USER=vigan_admin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

BACKEND_PORT=4000
FRONTEND_PORT=5173

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=vigan_ucrms
DATABASE_USER=vigan
